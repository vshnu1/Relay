{
  "name": "bayhacks-monitoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/api.integration.js",
    "format": "prettier --write src server shared workflows tests/*.js README.md docs/*.md vite.config.js package.json render.yaml"
  },
  "dependencies": {
    "@elevenlabs/client": "1.25.0",
    "@renderinc/sdk": "^1.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
