node_modules/
dist/
.vite/
.env
.env.*
!.env.example
# Anchored. An unanchored `data/` matches a directory named data at ANY depth,
# which silently swallowed src/recovery/data/ — four frontend modules were
# committed-away without a warning and main could not build. This rule is only
# meant to protect the repo-root working directory holding raw health exports.
/data/
.DS_Store
*.log

__pycache__/
*.pyc
